# Azure SQL Database Configuration
# For Managed Identity (recommended in Azure): Leave DB_USER and DB_PASSWORD empty
# For Local Development (SQL Authentication): Set DB_USER and DB_PASSWORD

DB_SERVER=your-server.database.windows.net
DB_NAME=your_database_name

# Optional - Use only for local development with SQL authentication
# DB_USER=your_username@your-server
# DB_PASSWORD=your_password

